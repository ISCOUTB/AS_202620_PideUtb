# Valores de ejemplo para probar el compose en tu computador.
#
#   cp deploy/.env.example deploy/.env
#   docker compose --env-file deploy/.env -f deploy/compose.lab.yaml up --build
#
# `deploy/.env` está en `.gitignore` y no se sube nunca.
#
# En el servidor del laboratorio este archivo NO se usa: los valores reales se
# escriben en el panel (pestaña Environment) y Dokploy genera el `.env` allí.
# Por eso aquí solo hay valores de juguete.

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=pideutb
POSTGRES_PASSWORD=contrasena-solo-para-probar-en-local
POSTGRES_DB=pideutb

# --- Secreto compartido con la pasarela --------------------------------------
#
# En producción tiene que ser un valor generado, largo y aleatorio:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Nunca una palabra ni algo que ya esté escrito en el repositorio: esa fue
# exactamente la forma de V-11 (docs/violaciones.md).
PIDEUTB_SECRETO_PASARELA=secreto-solo-para-probar-en-local

# --- Primera cuenta del panel ------------------------------------------------
#
# Solo se usa si la tabla `usuarios` está **vacía**. Es la única forma de crear
# la cuenta inicial en el laboratorio: la base no publica puertos y el panel no
# da terminal, así que `crear_usuario.py` no se puede ejecutar contra
# producción.
#
# Si estas variables faltan, no se crea nada. Una cuenta inicial con contraseña
# conocida sería peor que no tener cuenta.
PIDEUTB_USUARIO_INICIAL_CORREO=mostrador@utb.edu.co
PIDEUTB_USUARIO_INICIAL_CONTRASENA=contrasena-solo-para-probar-en-local
PIDEUTB_USUARIO_INICIAL_ESTABLECIMIENTO=1

# --- Pasarela simulada -------------------------------------------------------
#
# **Déjala vacía en producción.** Con un valor aquí, PideUTB deja de mandar a
# pagar a Wompi y manda a una página de este mismo sitio con dos botones,
# «Pagar» y «Rechazar», y habilita la ruta que esa página usa para avisar.
#
# Es lo que permite recorrer el flujo entero —pedido, cobro, código de canje—
# sin una cuenta de comercio: hace falta para una demostración y para
# desarrollar sin red.
#
# El riesgo es evidente y por eso no tiene valor por defecto: donde esté
# definida, **cualquiera que alcance esa ruta puede dar un pedido por pagado**.
# Sin ella la ruta responde 404, igual que una que no existe.
#
# El valor es la dirección pública de la página, sin parámetros. PideUTB le
# añade la referencia, el importe y el método.
PIDEUTB_URL_PASARELA_SIMULADA=http://localhost:8080/pasarela.html
